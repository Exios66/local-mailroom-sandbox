# local-mailroom-sandbox — local-first environment template
# Copy to .env at the repo root (or config/.env). Cloud keys stay commented.
# Full guide: docs/providers.md

# ── Sandbox identity ───────────────────────────────────────────────────────
SANDBOX_PROFILE=ollama                 # ollama | vllm-local | modal-vllm | llamacpp | lmstudio | openrouter
SANDBOX_ROOT=.                         # override if running from another cwd
MAILROOM_BASE_DIR=./data
OBSERVABILITY_PROVIDER=phoenix         # phoenix | langfuse | braintrust | auto | none
OBSERVABILITY_ENVIRONMENT=sandbox
PHOENIX_TRACING=enabled
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=mailroom-sandbox
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# ── Local providers (defaults match config/profiles/*.yaml) ────────────────
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1
GENERIC_BASE_URL=http://localhost:8080/v1
# LM Studio:
# GENERIC_BASE_URL=http://localhost:1234/v1
VLLM_API_KEY=
GENERIC_API_KEY=

# ── Modal-deployed vLLM (optional; see deploy/README.md) ───────────────────
# DEFAULT_PROVIDER=vllm
# SANDBOX_PROFILE=modal-vllm
# VLLM_BASE_URL=https://<workspace>--sandbox-vllm-serve.modal.run/v1
# VLLM_API_KEY=<same as MODAL_VLLM_API_TOKEN>
# MODAL_VLLM_MODEL=Qwen/Qwen3-8B
# MODAL_VLLM_GPU=L4
# MODAL_VLLM_MAX_MODEL_LEN=32768
# MODAL_VLLM_API_TOKEN=
# HF_TOKEN=

# ── Opt-in cloud API (never the sandbox default) ───────────────────────────
# SANDBOX_PROFILE=openrouter
# DEFAULT_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional local Langfuse (compose profile `langfuse`) ───────────────────
# OBSERVABILITY_PROVIDER=langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000

# ── Optional Braintrust ────────────────────────────────────────────────────
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=mailroom-sandbox

# ── Mailroom source checkout (scripts / legalbench package) ────────────────
# MAILROOM_SRC=./vendor/llm-mailroom
# ENTITY_SRC=./vendor/llm-entity-extraction
