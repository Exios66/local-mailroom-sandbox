# vllm_batch_eval.sub — CHTC/HTCondor batch job: in-job vLLM + offline
# sandbox evals (HUB-026). This is the pattern that works on CHTC's SHARED
# GPU Lab, where `condor_ssh_to_job` is unavailable: the job hosts vLLM
# itself for its lifetime, runs the sandbox evals against it, and transfers
# the reports back. No server, no tunnel.
#
# Adapt before submitting: CHTC_USERNAME, staging paths, and the tarball
# names produced by the one-time setup in README.md.
#
#   condor_submit vllm_batch_eval.sub

universe = vanilla
batch_name = mailroom-sandbox-eval

log = logs/eval_$(Cluster)_$(Process).log
output = logs/eval_$(Cluster)_$(Process).out
error = logs/eval_$(Cluster)_$(Process).err

executable = run_batch_eval.sh
transfer_input_files = mailroom-sandbox.tar.gz, env-mailroom-sandbox.tar.gz
# results/ carries the experiment log + scorecards back to the access point
transfer_output_files = results
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# vLLM container (pulled from Docker Hub by Apptainer on the execute node).
# Alternative: build a .sif once and stage it:
#   container_image = osdf:///chtc/staging/CHTC_USERNAME/vllm-openai.sif
container_image = docker://vllm/vllm-openai:v0.8.5

+WantGPULab = true
+GPUJobLength = "medium"
# +is_resumable = true   # uncomment only if your evals checkpoint < 4-6h

request_gpus = 1
gpus_minimum_memory = 16000
request_cpus = 4
request_memory = 32GB
request_disk = 40GB

queue 1
