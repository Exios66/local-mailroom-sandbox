# vllm_serve.sub — CHTC/HTCondor SERVER variant (HUB-026).
#
# ONLY for researcher-OWNED / prioritized GPU machines: CHTC's shared GPU
# Lab machines do not allow `condor_ssh_to_job`, so you cannot reach a
# long-running server there — use vllm_batch_eval.sub on the shared pool.
# On an owned machine this job serves vLLM for its lifetime and you forward
# it locally with `condor_ssh_to_job` + the `vllm-remote` profile
# (see README.md, "Server path").
#
#   condor_submit vllm_serve.sub

universe = vanilla
batch_name = mailroom-sandbox-vllm-serve

log = logs/serve_$(Cluster).log
output = logs/serve_$(Cluster).out
error = logs/serve_$(Cluster).err

executable = serve_vllm.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXITOR_GRACEFUL_REMOVAL

container_image = docker://vllm/vllm-openai:v0.8.5

+WantGPULab = false
+GPUJobLength = "long"

request_gpus = 1
gpus_minimum_memory = 16000
request_cpus = 4
request_memory = 32GB
request_disk = 40GB

# hold instead of evicting while you are using the server
periodic_hold = (NumJobStarts > 0 && time() - JobStartDate > 86400)

queue 1
